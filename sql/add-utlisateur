/* =============================================================================
   Migration : comptes utilisateurs et produits favoris
   -----------------------------------------------------------------------------
   À exécuter sur une base mediatheque existante :

       sqlcmd -S localhost -E -d mediatheque -i sql/add-utilisateurs-favoris.sql

   Nécessite des droits d'administration : mediatheque_user n'a que db_datareader et
   db_datawriter, il ne peut pas créer de table. Il n'a pas besoin de droits
   supplémentaires ensuite : ces deux rôles couvrent automatiquement les
   nouvelles tables du schéma dbo.

   ENCODAGE : fichier UTF-8 AVEC BOM (voir create-database.sql).
   ============================================================================= */

USE mediatheque;
GO

/* -----------------------------------------------------------------------------
   1. Utilisateurs
   -------------------------------------------------------------------------- */

-- ⚠️ Supprimer d'abord les tables qui référencent users (FK)
DROP TABLE IF EXISTS dbo.favori;
DROP TABLE IF EXISTS dbo.possede;    
DROP TABLE IF EXISTS dbo.users;
GO

CREATE TABLE dbo.users (
    id_utilisateur INT           IDENTITY (1, 1) NOT NULL,
    email          NVARCHAR (180) NOT NULL,

    -- 255 caractères : on ne stocke JAMAIS le mot de passe, mais son empreinte
    -- produite par password_hash(). Bcrypt en fait 60, mais les algorithmes plus
    -- récents (argon2id) sont plus longs : on prévoit large.
    password       NVARCHAR (255) NOT NULL,
    role           NVARCHAR (10) NOT NULL
        CONSTRAINT DF_users_role DEFAULT 'user',

    date_creation  DATETIME2      NOT NULL
        CONSTRAINT DF_users_date DEFAULT SYSUTCDATETIME(),

    CONSTRAINT PK_users PRIMARY KEY (id_utilisateur),

    -- email est NOT NULL : la contrainte UNIQUE ne pose donc pas le problème
    -- des NULL multiples rencontré sur l'ISBN.
    CONSTRAINT UQ_users_email UNIQUE (email)
);
GO

/* -----------------------------------------------------------------------------
   2. Favoris — table de liaison
   -----------------------------------------------------------------------------
   Un utilisateur aime plusieurs produits, un produit est aimé par plusieurs
   utilisateurs : c'est une relation PLUSIEURS-À-PLUSIEURS. Elle ne peut pas se
   représenter par une simple clé étrangère dans l'une des deux tables — il faut
   une table intermédiaire, qui ne contient que les deux clés.
   -------------------------------------------------------------------------- */

CREATE TABLE dbo.favori (
    id_utilisateur INT       NOT NULL,
    id_produit     INT       NOT NULL,
    date_ajout     DATETIME2 NOT NULL
        CONSTRAINT DF_favori_date DEFAULT SYSUTCDATETIME(),

    -- Clé primaire COMPOSÉE des deux colonnes : c'est elle qui garantit qu'un
    -- même produit ne peut pas être mis deux fois en favori par le même
    -- utilisateur. La garantie est dans la base, pas seulement dans le code PHP.
    CONSTRAINT PK_favori PRIMARY KEY (id_utilisateur, id_produit),

    -- ON DELETE CASCADE des deux côtés : supprimer un utilisateur ou un produit
    -- retire les lignes de favoris correspondantes, qui n'auraient plus de sens.
    CONSTRAINT FK_favori_users FOREIGN KEY (id_utilisateur)
        REFERENCES dbo.users (id_utilisateur) ON DELETE CASCADE,

    CONSTRAINT FK_favori_produit FOREIGN KEY (id_produit)
        REFERENCES dbo.produit (id_produit) ON DELETE CASCADE
);
GO

-- La clé primaire indexe déjà (id_utilisateur, id_produit), ce qui couvre les
-- recherches « les favoris de tel utilisateur ». L'index inverse sert aux
-- recherches « qui a mis ce produit en favori ».
CREATE INDEX IX_favori_produit_id ON dbo.favori (id_produit);
GO

/* -----------------------------------------------------------------------------
   3. Vérification
   -------------------------------------------------------------------------- */

SELECT  t.name        AS [table],
        COUNT(c.column_id) AS colonnes
FROM    sys.tables t
        JOIN sys.columns c ON c.object_id = t.object_id
WHERE   t.name IN ('users', 'favori')
GROUP BY t.name;
GO